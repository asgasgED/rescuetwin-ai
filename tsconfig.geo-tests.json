{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": ".test-build",
    "rootDir": "src",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "src/types/simulation.ts",
    "src/lib/graph.ts",
    "src/lib/simulator.ts",
    "src/lib/generated/dataset.ts",
    "src/app/api/simulate/route.ts"
  ],
  "exclude": [
    ".test-build",
    "node_modules"
  ]
}
